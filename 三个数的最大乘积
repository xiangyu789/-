class Solution {
public:
    int maximumProduct(vector<int>& nums) {
        int res=1,i=0;
        sort(nums.begin(),nums.end());
        int n=nums.size();
        for(i=n-3;i<n;++i)
        {
            res*=nums[i];
        }
        if(nums[0]*nums[1]*nums[n-1]>res)     //判断是否存在两个负数乘积较大情况
        res=nums[0]*nums[1]*nums[n-1];
        return res;
    }
};
