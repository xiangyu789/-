int countPrimes(int n) {
    int i,j,s,r=0;
    if(n==0||n==1)
    {
        printf("%d",0);
    }
    else{
       for(i=2;i<n;i++)
    {
        s=0;
        for(j=2;j<i;j++)
        {
            if(i%j==0)
            {
                s++;
                break;
            }
        }
        if(s==0)
        {
            r++;
        }
    } 
    }
    return r;
}
