class Solution {
public:
    vector<int> intersection(vector<int>& nums1, vector<int>& nums2) {
        sort(nums1.begin(),nums1.end());
        sort(nums2.begin(),nums2.end());
        int i=0,j=0;
        int a=nums1.size();
        int b=nums2.size();
        vector<int>arr;
        while(i<a && j<b)
        {
            while(i+1<a && nums1[i]==nums1[i+1])
            {
                ++i;
            }
            while(j+1<b && nums2[j]==nums2[j+1])
            {
                ++j;
            }
            if(nums1[i]==nums2[j])
            {
                arr.push_back(nums1[i]);
                ++i;
                ++j;
            }
            else if(nums1[i]<nums2[j])
            {
                ++i;
            }
            else ++j;
        }
        return arr;
    }
};
