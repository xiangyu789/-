class Solution {
public:
    vector<int> getConcatenation(vector<int>& nums) {
        int n=nums.size();
        vector<int>ans(2*n);
        int i,j;
        for(i=0;i<n;++i)
        {
            ans[i]=nums[i];
        }
        for(j=n,i=0;j<2*n,i<n;++j,++i)
        {
            ans[j]=nums[i];
        }
        return ans;
    }
};
