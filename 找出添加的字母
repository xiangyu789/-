class Solution {
public:
    char findTheDifference(string s, string t) {
        sort(s.begin(),s.end());
        sort(t.begin(),t.end());
        int i=0,j=0;
        int a=s.size();
        int b=t.size();
        while(i<a && j<b)
        {
            if(s[i]==t[j])
            {
                ++i;
                ++j;
            }
            else return t[j];
        }
        return t[b-1];
    }
};
