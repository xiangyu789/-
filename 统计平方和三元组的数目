#include<iostream>
#include<cmath>
using namespace std;
class Solution {
public:
    int countTriples(int n) {
        int a,b,c,r=0;
        for(a=1;a<=n;++a)
        {
            for(b=1;b<=n;++b)
            {
                c=sqrt(a*a+b*b);
                if(c>=1 && c<=n && c*c==a*a+b*b)
                {
                    ++r;
                }
            }
        }
       return r; 
    }  
};
