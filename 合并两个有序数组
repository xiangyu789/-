class Solution {
public:
    void merge(vector<int>& nums1, int m, vector<int>& nums2, int n) {
        vector<int> arr(m + n);
        int i, j, d;
        if (m != 0) {
            for (i = 0; i < m; ++i) {
                arr[i] = nums1[i];
            }
            if (n != 0) {
                for (i = m, j = 0; i < m + n; ++i) {
                    arr[i] = nums2[j];
                    ++j;
                }
            }
            for (i = 0; i < n + m; ++i) {
                for (j = 0; j < m + n - 1; ++j) {
                    if (arr[j] > arr[j + 1]) {
                        d = arr[j];
                        arr[j] = arr[j + 1];
                        arr[j + 1] = d;
                    }
                }
            }
        } else {
            for (i = 0; i < n; ++i) {
                arr[i] = nums2[i];
            }
        }
        for (i = 0; i < m + n; ++i) {
            nums1[i] = arr[i];
        }
    }
};
