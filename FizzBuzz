char** fizzBuzz(int n, int* returnSize) {
    int i;
     char **str = malloc((n + 1) * sizeof(char*));
    for(i=0;i<n;++i)
    {
        str[i] = malloc(50); 
        if((i+1)%5==0 &&(i+1)%3==0)
        {
            strcpy(str[i],"FizzBuzz");
        }
        else if((i+1)%3==0)
        {
            strcpy(str[i],"Fizz") ;
        }
        else if((i+1)%5==0)
        {
            strcpy(str[i],"Buzz") ;
        }
        else sprintf(str[i], "%d", i+1);
    }
    *returnSize = n;
    return str;
}
